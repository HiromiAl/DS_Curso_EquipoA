import numpy as np

# Semilla para obtener siempre los mismos resultados
np.random.seed(10)

# Número aleatorio entre 0 y 1
numero = np.random.rand()
print("Número aleatorio:", numero)

# Arreglo de 10 números aleatorios
vector = np.random.rand(10)
print("\nVector aleatorio:")
print(vector)

# Matriz 3x3 de números aleatorios
matriz = np.random.rand(3, 3)
print("\nMatriz aleatoria:")
print(matriz)

# Números enteros aleatorios del 1 al 100
enteros = np.random.randint(1, 101, size=10)
print("\nEnteros aleatorios:")
print(enteros)

# Estadísticas
print("\nPromedio:", np.mean(enteros))
print("Máximo:", np.max(enteros))
print("Mínimo:", np.min(enteros))
